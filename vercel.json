{
  "services": {
    "smtp-app": {
      "root": "apps/smtp",
      "framework": "nextjs"
    },
    "ziina-app": {
      "root": "apps/ziina",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/smtp",
      "destination": {
        "service": "smtp-app"
      }
    },
    {
      "source": "/smtp/(.*)",
      "destination": {
        "service": "smtp-app"
      }
    },
    {
      "source": "/ziina",
      "destination": {
        "service": "ziina-app"
      }
    },
    {
      "source": "/ziina/(.*)",
      "destination": {
        "service": "ziina-app"
      }
    }
  ]
}
